# Local: copy to .env, then `docker compose -f docker-compose.dev.yml up -d`
# Dokploy: put only the production values you care about in the Environment tab.
# Dokploy writes `.env` itself — never create that file on the server.
# Salts can be omitted; they are generated and persisted automatically.

DB_NAME='wordpress'
DB_USER='wordpress'
DB_PASSWORD='password'
DB_HOST='database'

WP_ENV='development'
WP_HOME='http://localhost:8080'
WP_SITEURL='http://localhost:8080/wp'

WP_REDIS_HOST='redis'

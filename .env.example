# Local: copy to .env, then `docker compose -f docker-compose.dev.yml up -d`
# Dokploy Environment (minimum):
# WP_HOME=https://your-domain
# DB password and salts are generated automatically.

DB_NAME='wordpress'
DB_USER='wordpress'
DB_PASSWORD='password'
DB_HOST='database'

WP_ENV='development'
WP_HOME='http://localhost:8080'
WP_SITEURL='http://localhost:8080/wp'

WP_REDIS_HOST='redis'
